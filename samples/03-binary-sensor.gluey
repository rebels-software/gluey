// Demo 3: Binary Sensor
// A workflow that decodes binary protocol payloads with various endianness types.
// Demonstrates int16_be (big-endian), uint16_le (little-endian), and uint8 fields.
//
// Binary format (12 bytes total):
//   Bytes 0-3:   device_id (ASCII string, e.g., "SN01")
//   Bytes 4-5:   temperature (int16_be, °C * 100, e.g., 2350 = 23.50°C)
//   Bytes 6-7:   humidity (uint16_le, % * 100, e.g., 6520 = 65.20%)
//   Bytes 8:     battery_level (uint8, 0-100%)
//   Bytes 9:     status_flags (uint8, bit flags)
//   Bytes 10-11: sequence_num (uint16_be, message sequence)
//
// To test:
// 1. Run: dotnet run --project src/Gluey.Cli -- run samples/03-binary-sensor.gluey
// 2. Send binary data (base64 encoded in JSON):
//    curl -X POST http://localhost:8080/webhook \
//         -H "Content-Type: application/json" \
//         -d '{"data": "U04wMQkyGAhXADAB"}'
//
// http-app local 1.0.0 {
//   host: "localhost"
//   port http: 8080
//   auth: []
// }
//
// binary sensor-frame 1.0.0 {
//   properties: {
//     device_id: text 1.0.0 {
//       required: true
//       offset: 0
//       length: 4
//       encoding: "ascii"
//       displayName: { "en-US": "Device ID" }
//       description: { "en-US": "Sensor identifier" }
//     }
//     temperature_raw: int16 1.0.0 {
//       required: true
//       offset: 4
//       length: 2
//       endian: "big"
//       displayName: { "en-US": "Temperature Raw" }
//       description: { "en-US": "Temperature in centidegrees Celsius" }
//     }
//     humidity_raw: uint16 1.0.0 {
//       required: true
//       offset: 6
//       length: 2
//       endian: "little"
//       displayName: { "en-US": "Humidity Raw" }
//       description: { "en-US": "Humidity in hundredths of percent" }
//     }
//     battery: uint8 1.0.0 {
//       required: true
//       offset: 8
//       length: 1
//       displayName: { "en-US": "Battery" }
//       description: { "en-US": "Battery level 0-100%" }
//     }
//     status_flags: uint8 1.0.0 {
//       required: true
//       offset: 9
//       length: 1
//       displayName: { "en-US": "Status Flags" }
//       description: { "en-US": "Device status bit flags" }
//     }
//     sequence_num: uint16 1.0.0 {
//       required: true
//       offset: 10
//       length: 2
//       endian: "big"
//       displayName: { "en-US": "Sequence Number" }
//       description: { "en-US": "Message sequence number" }
//     }
//   }
// }
//
// json ok 1.0.0 {
//   properties: {
//     status: text 1.0.0 {
//       required: true
//       const: "ok"
//       displayName: { "en-US": "Status" }
//       description: { "en-US": "Acknowledgement status" }
//     }
//   }
// }
//
// http-endpoint binary-webhook 1.0.0 {
//   app: local 1.0.0
//   plugin: http 1.1.0
//   method: POST
//   path: "/webhook"
//   payload: binary sensor-frame 1.0.0
//   responses: {
//     200: json ok 1.0.0
//   }
// }

flow binary-sensor 1.0.0 {
  from http-endpoint binary-webhook 1.0.0

  | transform {
      output.device_id          <- input.device_id
      output.temperature_celsius <- input.temperature_raw / 100
      output.humidity_percent    <- input.humidity_raw / 100
      output.battery_percent     <- input.battery
      output.is_online           <- input.status_flags == 0 ? true : false
      output.sequence            <- input.sequence_num
      output.processed_at        <- now()
    }
  | console()
}
