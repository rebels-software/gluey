// Demo 6: Fan-out Pattern
// A workflow demonstrating parallel output (fan-out) where a single message is
// delivered to multiple destinations simultaneously. The incoming JSON is
// enriched with a timestamp and device summary, then sent to both the console
// and an HTTP endpoint at the same time.
//
// To test:
// 1. Run: dotnet run --project src/Gluey.Cli -- run samples/06-fanout-pattern.gluey
// 2. Send: curl -X POST http://localhost:8080/webhook \
//            -H "Content-Type: application/json" \
//            -d '{"device_id": "sensor-042", "temperature": 23.5, "status": "online"}'
//
// http-app local 1.0.0 {
//   host: "localhost"
//   port http: 8080
//   auth: []
// }
//
// http-app external 1.0.0 {
//   host: "webhook.site"
//   port http: 443
//   auth: []
//   tls: { ca_certificate: system }
// }
//
// json device-event 1.0.0 {
//   properties: {
//     device_id: text 1.0.0 {
//       required: true
//       displayName: { "en-US": "Device ID" }
//       description: { "en-US": "Device identifier" }
//     }
//     temperature: float64 1.0.0 {
//       required: true
//       displayName: { "en-US": "Temperature" }
//       description: { "en-US": "Temperature in degrees Celsius" }
//     }
//     status: text 1.0.0 {
//       required: true
//       displayName: { "en-US": "Status" }
//       description: { "en-US": "Device operational status" }
//     }
//   }
// }
//
// json device-summary 1.0.0 {
//   properties: {
//     device_id: text 1.0.0 { required: true }
//     temperature: float64 1.0.0 { required: true }
//     status: text 1.0.0 { required: true }
//     device_summary: text 1.0.0 { required: true }
//     processed_at: timestamp 1.0.0 { required: true }
//   }
// }
//
// json ok 1.0.0 {
//   properties: {
//     status: text 1.0.0 { required: true, const: "ok" }
//   }
// }
//
// json error 1.0.0 {
//   properties: {
//     error: text 1.0.0 { required: true }
//   }
// }
//
// http-endpoint fanout-webhook 1.0.0 {
//   app: local 1.0.0
//   plugin: http 1.1.0
//   method: POST
//   path: "/webhook"
//   payload: json device-event 1.0.0
//   responses: {
//     200: json ok 1.0.0
//   }
// }
//
// http-endpoint webhook-site 1.0.0 {
//   app: external 1.0.0
//   plugin: http 2.0.0
//   method: POST
//   path: "/test"
//   headers: webhook-site-headers 1.0.0
//   payload: json device-summary 1.0.0
//   responses: {
//     200: json ok 1.0.0
//     default: json error 1.0.0
//   }
// }

flow fanout-pattern 1.0.0 {
  from http-endpoint fanout-webhook 1.0.0

  | transform {
      output.device_id       <- input.device_id
      output.temperature     <- input.temperature
      output.status          <- input.status
      output.device_summary  <- input.device_id + " is " + input.status
      output.processed_at    <- now()
    }

  | gateway parallel {
      -> console()
      -> to http-endpoint webhook-site 1.0.0
    }
}
